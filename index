<!DOCTYPE html>
<html lang="ja">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>お笑いMBTI - ユーモア構造診断</title>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <style>
        :root {
            --bg-color: #f8fafc;
            --card-bg: #ffffff;
            --primary: #2563eb; /* Blue: Logic/Pop */
            --accent: #dc2626;  /* Red: Absurd/Poison */
            --text-main: #1e293b;
            --text-sub: #64748b;
            --bar-bg: #e2e8f0;
        }

        body {
            font-family: "Hiragino Kaku Gothic ProN", "Meiryo", sans-serif;
            background-color: var(--bg-color);
            color: var(--text-main);
            margin: 0;
            padding: 0;
            display: flex;
            flex-direction: column;
            min-height: 100vh;
        }

        /* Header */
        header {
            background: var(--card-bg);
            padding: 20px;
            box-shadow: 0 4px 6px -1px rgba(0,0,0,0.1);
            text-align: center;
            z-index: 10;
        }
        h1 { margin: 0; font-size: 1.5rem; color: var(--text-main); letter-spacing: 0.05em; }
        .subtitle { font-size: 0.85rem; color: var(--text-sub); margin-top: 5px; display: block;}

        /* Main Container */
        .container {
            max-width: 700px;
            margin: 40px auto 140px; /* Space for dashboard */
            padding: 0 20px;
            flex-grow: 1;
        }

        /* Question Card */
        .q-card {
            background: var(--card-bg);
            border-radius: 20px;
            padding: 40px 30px;
            box-shadow: 0 10px 25px -5px rgba(0,0,0,0.1);
            text-align: center;
            animation: fadeIn 0.4s ease-out;
        }
        @keyframes fadeIn { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: translateY(0); } }

        .q-meta {
            font-size: 0.8rem;
            text-transform: uppercase;
            letter-spacing: 1px;
            color: var(--text-sub);
            margin-bottom: 15px;
            display: block;
        }
        .q-text {
            font-size: 1.4rem;
            font-weight: bold;
            margin-bottom: 40px;
            line-height: 1.5;
        }

        /* Scale Labels */
        .scale-labels {
            display: flex;
            justify-content: space-between;
            margin-bottom: 15px;
            font-size: 0.9rem;
            font-weight: bold;
        }
        .label-left { color: var(--primary); width: 45%; text-align: left; }
        .label-right { color: var(--accent); width: 45%; text-align: right; }

        /* Gradient Track Buttons */
        .gradient-track {
            display: flex;
            justify-content: space-between;
            align-items: center;
            position: relative;
            height: 60px;
        }
        .track-line {
            position: absolute;
            top: 50%;
            left: 0;
            right: 0;
            height: 2px;
            background: #cbd5e1;
            z-index: 0;
        }
        .center-mark {
            position: absolute;
            left: 50%;
            top: 20%;
            bottom: 20%;
            width: 2px;
            background: #94a3b8;
            transform: translateX(-50%);
            z-index: 0;
        }

        .scale-btn {
            width: 40px;
            height: 40px;
            border-radius: 50%;
            border: 2px solid #cbd5e1;
            background: #fff;
            cursor: pointer;
            z-index: 1;
            transition: all 0.2s cubic-bezier(0.175, 0.885, 0.32, 1.275);
        }
        .scale-btn:hover { border-color: var(--text-sub); background: #f1f5f9; }
        
        /* Sizes based on weight */
        .scale-btn[data-val="-3"] { width: 55px; height: 55px; border-color: var(--primary); border-width: 3px; }
        .scale-btn[data-val="-2"] { width: 48px; height: 48px; border-color: #60a5fa; }
        .scale-btn[data-val="-1"] { width: 40px; height: 40px; border-color: #93c5fd; }
        
        .scale-btn[data-val="1"] { width: 40px; height: 40px; border-color: #fca5a5; }
        .scale-btn[data-val="2"] { width: 48px; height: 48px; border-color: #f87171; }
        .scale-btn[data-val="3"] { width: 55px; height: 55px; border-color: var(--accent); border-width: 3px; }

        /* Dashboard (Fixed Footer) */
        .dashboard {
            position: fixed;
            bottom: 0;
            left: 0;
            width: 100%;
            background: rgba(255, 255, 255, 0.9);
            backdrop-filter: blur(12px);
            border-top: 1px solid #e2e8f0;
            padding: 15px 0;
            z-index: 100;
        }
        .dash-inner {
            max-width: 600px;
            margin: 0 auto;
            padding: 0 20px;
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 8px 30px;
        }
        .bar-row {
            display: flex;
            align-items: center;
            font-size: 0.7rem;
            font-weight: bold;
        }
        .bar-label { width: 30px; }
        .bar-track {
            flex-grow: 1;
            height: 6px;
            background: var(--bar-bg);
            border-radius: 3px;
            margin: 0 8px;
            position: relative;
            overflow: hidden;
        }
        .bar-fill {
            position: absolute;
            height: 100%;
            width: 0%;
            left: 50%;
            transition: all 0.5s ease;
        }

        /* Result Area */
        #result-area { display: none; }
        .result-header { text-align: center; margin-bottom: 30px; }
        .type-code { font-size: 4rem; font-weight: 800; color: var(--text-main); letter-spacing: 5px; line-height: 1; }
        .type-title { font-size: 1.5rem; color: var(--primary); margin-top: 10px; font-weight: bold; }
        
        .result-content {
            background: var(--card-bg);
            border-radius: 16px;
            padding: 30px;
            box-shadow: 0 4px 20px rgba(0,0,0,0.05);
            margin-bottom: 30px;
        }
        .chart-container {
            max-width: 400px;
            margin: 0 auto 30px;
        }
        .desc-section { margin-bottom: 20px; border-bottom: 1px solid #eee; padding-bottom: 20px; }
        .desc-section:last-child { border-bottom: none; }
        .desc-label { font-size: 0.85rem; color: var(--text-sub); font-weight: bold; display: block; margin-bottom: 8px; }
        .desc-text { font-size: 1rem; line-height: 1.8; }
        
        .tag {
            display: inline-block;
            background: #f1f5f9;
            padding: 4px 10px;
            border-radius: 4px;
            font-size: 0.85rem;
            margin-right: 5px;
            margin-bottom: 5px;
            color: #475569;
        }

        .btn-restart {
            display: block;
            width: 100%;
            max-width: 300px;
            margin: 0 auto;
            padding: 15px;
            background: var(--text-main);
            color: #fff;
            border: none;
            border-radius: 30px;
            font-size: 1rem;
            cursor: pointer;
            transition: transform 0.1s;
        }
        .btn-restart:hover { transform: scale(1.02); }

        .hidden { display: none !important; }
    </style>
</head>
<body>

<header>
    <h1>お笑いMBTI</h1>
    <span class="subtitle">ユーモア構造解析 & 芸風診断システム</span>
</header>

<div class="container" id="quiz-area">
    <div class="q-card">
        <span class="q-meta" id="q-progress">QUESTION 1 / 20</span>
        
        <div class="scale-labels">
            <span class="label-left" id="label-left">Left Concept</span>
            <span class="label-right" id="label-right">Right Concept</span>
        </div>
        
        <div class="q-text" id="q-text">Question text goes here...</div>

        <div class="gradient-track">
            <div class="track-line"></div>
            <div class="center-mark"></div>
            <button class="scale-btn" onclick="next(-3)" data-val="-3"></button>
            <button class="scale-btn" onclick="next(-2)" data-val="-2"></button>
            <button class="scale-btn" onclick="next(-1)" data-val="-1"></button>
            
            <div style="width: 30px"></div> <button class="scale-btn" onclick="next(1)" data-val="1"></button>
            <button class="scale-btn" onclick="next(2)" data-val="2"></button>
            <button class="scale-btn" onclick="next(3)" data-val="3"></button>
        </div>
    </div>
</div>

<div class="container" id="result-area">
    <div class="result-header">
        <div>DIAGNOSTIC RESULT</div>
        <div class="type-code" id="res-code">----</div>
        <div class="type-title" id="res-title">Type Name</div>
    </div>

    <div class="result-content">
        <div class="chart-container">
            <canvas id="radarChart"></canvas>
        </div>

        <div class="desc-section">
            <span class="desc-label">基本特性 (Overview)</span>
            <div class="desc-text" id="res-overview"></div>
        </div>

        <div class="desc-section">
            <span class="desc-label">集団での役割 (Role)</span>
            <div class="desc-text" id="res-role"></div>
        </div>

        <div class="desc-section">
            <span class="desc-label">キーワード (Keywords)</span>
            <div id="res-tags"></div>
        </div>
        
        <div class="desc-section">
            <span class="desc-label">類似するスタイル/芸人像 (Reference)</span>
            <div class="desc-text" id="res-ref" style="font-style: italic; color:#666;"></div>
        </div>
    </div>

    <button class="btn-restart" onclick="location.reload()">最初から診断する</button>
</div>

<div class="dashboard" id="dashboard">
    <div class="dash-inner">
        <div class="bar-row">
            <span class="bar-label" style="color:var(--primary)">論理</span>
            <div class="bar-track"><div class="bar-fill" id="bar-la"></div></div>
            <span class="bar-label" style="color:var(--accent); text-align:right">不条理</span>
        </div>
        <div class="bar-row">
            <span class="bar-label" style="color:var(--primary)">親和</span>
            <div class="bar-track"><div class="bar-fill" id="bar-hp"></div></div>
            <span class="bar-label" style="color:var(--accent); text-align:right">毒</span>
        </div>
        <div class="bar-row">
            <span class="bar-label" style="color:var(--primary)">動的</span>
            <div class="bar-track"><div class="bar-fill" id="bar-ds"></div></div>
            <span class="bar-label" style="color:var(--accent); text-align:right">静的</span>
        </div>
        <div class="bar-row">
            <span class="bar-label" style="color:var(--primary)">大衆</span>
            <div class="bar-track"><div class="bar-fill" id="bar-mc"></div></div>
            <span class="bar-label" style="color:var(--accent); text-align:right">コア</span>
        </div>
    </div>
</div>

<script>
    /*
      AXES:
      1. LA: Logic (Left) vs Absurd (Right)
      2. HP: Harmony (Left) vs Poison (Right)
      3. DS: Dynamic (Left) vs Static (Right)
      4. MC: Mass/Pop (Left) vs Core/Cult (Right)
    */

    const questions = [
        // --- LA: Logic vs Absurd (5問) ---
        { axis: "LA", text: "コメディ作品において重要視するのは？", left: "伏線回収や構成の巧みさ", right: "意味不明な展開やカオス感" },
        { axis: "LA", text: "「オチ」がない話に対してどう思う？", left: "モヤモヤする、意味不明", right: "投げっぱなし感が逆に面白い" },
        { axis: "LA", text: "好きな言葉遊びのタイプは？", left: "意味がかかっている上手いダジャレ", right: "語感とリズムだけの謎の造語" },
        { axis: "LA", text: "説明のつかない現象（ゴリラが爆発など）を見た時", left: "「なんでだよ！」と理由を求める", right: "理由など求めずただ受け入れる" },
        { axis: "LA", text: "ネタ作りをするなら？", left: "台本をきっちり書いて練習する", right: "その場のノリと即興性を信じる" },

        // --- HP: Harmony vs Poison (5問) ---
        { axis: "HP", text: "友人との会話でウケを狙うなら？", left: "平和な「あるある」で共感を得る", right: "鋭い「毒舌」でいじり倒す" },
        { axis: "HP", text: "ブラックジョークへの耐性は？", left: "誰かが傷つくなら笑えない", right: "不謹慎であればあるほど興奮する" },
        { axis: "HP", text: "笑いの社会的役割とは？", left: "人々の絆を深める潤滑油", right: "権威や常識を疑う武器" },
        { axis: "HP", text: "自分の失敗談を話す時", left: "「ドジな自分」を演じて場を和ます", right: "「理不尽な世界」を批判して笑わせる" },
        { axis: "HP", text: "いじり（Teasing）について", left: "信頼関係があっても慎重になるべき", right: "信頼関係があれば何を言ってもOK" },

        // --- DS: Dynamic vs Static (5問) ---
        { axis: "DS", text: "面白い人の特徴といえば？", left: "声が大きく、動きが激しい", right: "ボソッと呟き、表情を変えない" },
        { axis: "DS", text: "気まずい沈黙が訪れたとき", left: "音や言葉で埋めて勢いを作る", right: "その気まずい空気を楽しむ" },
        { axis: "DS", text: "好きなリズム感は？", left: "畳み掛けるマシンガントーク", right: "忘れた頃にやってくる遅いテンポ" },
        { axis: "DS", text: "顔芸や身体を張ったギャグは？", left: "大好き。理屈抜きで笑える", right: "あまり笑えない。幼稚に感じる" },
        { axis: "DS", text: "感情表現は？", left: "オーバーリアクション気味", right: "ポーカーフェイス気味" },

        // --- MC: Mass vs Core (5問) ---
        { axis: "MC", text: "ネタの「元ネタ」について", left: "誰でもわかる日常ネタが好き", right: "深い知識が必要なパロディが好き" },
        { axis: "MC", text: "作品の楽しみ方", left: "流行りのコンテンツを共有したい", right: "マイナーな作品を掘り下げたい" },
        { axis: "MC", text: "「ベタ（王道）」な展開は？", left: "安心感があって一番面白い", right: "予測できて退屈。裏切ってほしい" },
        { axis: "MC", text: "テレビのゴールデンタイムのバラエティは？", left: "よく見るし、面白いと思う", right: "あまり見ない、または物足りない" },
        { axis: "MC", text: "説明過多なテロップやナレーションは？", left: "親切でわかりやすい", right: "邪魔。解釈を限定されたくない" }
    ];

    let currentIdx = 0;
    // Scores range: -15 to +15 per axis (5 questions * 3 pts)
    let scores = { LA: 0, HP: 0, DS: 0, MC: 0 }; 

    function init() {
        renderQuestion();
        updateDashboard();
    }

    function renderQuestion() {
        const q = questions[currentIdx];
        document.getElementById('q-progress').innerText = `QUESTION ${currentIdx + 1} / ${questions.length}`;
        document.getElementById('q-text').innerText = q.text;
        document.getElementById('label-left').innerText = q.left;
        document.getElementById('label-right').innerText = q.right;
    }

    function next(val) {
        const axis = questions[currentIdx].axis;
        scores[axis] += val;
        
        updateDashboard();
        
        currentIdx++;
        if (currentIdx < questions.length) {
            // Small delay to allow button animation
            setTimeout(renderQuestion, 200);
        } else {
            showResults();
        }
    }

    function updateDashboard() {
        const maxScore = 15; // 5 questions * 3
        
        const setBar = (id, score) => {
            const el = document.getElementById(id);
            const clamped = Math.max(-maxScore, Math.min(maxScore, score));
            const percent = (Math.abs(clamped) / maxScore) * 50; // 0 to 50% width

            el.style.width = `${percent}%`;
            
            if (score >= 0) { // Right side (Positive)
                el.style.left = "50%";
                el.style.backgroundColor = "var(--accent)";
            } else { // Left side (Negative)
                el.style.left = `${50 - percent}%`;
                el.style.backgroundColor = "var(--primary)";
            }
        };

        setBar('bar-la', scores.LA);
        setBar('bar-hp', scores.HP);
        setBar('bar-ds', scores.DS);
        setBar('bar-mc', scores.MC);
    }

    function showResults() {
        document.getElementById('quiz-area').classList.add('hidden');
        document.getElementById('dashboard').classList.add('hidden');
        document.getElementById('result-area').style.display = 'block';

        // Determing Type Code
        const t1 = scores.LA <= 0 ? "L" : "A"; // Logic vs Absurd
        const t2 = scores.HP <= 0 ? "H" : "P"; // Harmony vs Poison
        const t3 = scores.DS <= 0 ? "D" : "S"; // Dynamic vs Static
        const t4 = scores.MC <= 0 ? "M" : "C"; // Mass vs Core
        
        const typeKey = t1 + t2 + t3 + t4;
        const data = getTypeData(typeKey);

        // Fill Text
        document.getElementById('res-code').innerText = typeKey;
        document.getElementById('res-title').innerText = data.title;
        document.getElementById('res-overview').innerHTML = data.overview;
        document.getElementById('res-role').innerHTML = data.role;
        document.getElementById('res-ref').innerText = data.ref;

        // Tags
        const tagsHTML = data.tags.map(t => `<span class="tag">#${t}</span>`).join('');
        document.getElementById('res-tags').innerHTML = tagsHTML;

        // Render Radar Chart
        renderChart();
    }

    function renderChart() {
        const ctx = document.getElementById('radarChart').getContext('2d');
        
        // Normalize scores to 0-100 range for the chart
        // Current: -15 to +15. 
        // Logic(0)..Absurd(100)
        // Harmony(0)..Poison(100)
        // Dynamic(0)..Static(100)
        // Mass(0)..Core(100)
        
        const normalize = (val) => ((val + 15) / 30) * 100;

        new Chart(ctx, {
            type: 'radar',
            data: {
                labels: ['不条理度 (Absurdity)', '毒/攻撃性 (Poison)', '静寂/間 (Static)', 'コア/深さ (Core)'],
                datasets: [{
                    label: 'あなたのユーモア成分',
                    data: [
                        normalize(scores.LA), 
                        normalize(scores.HP), 
                        normalize(scores.DS), 
                        normalize(scores.MC)
                    ],
                    backgroundColor: 'rgba(37, 99, 235, 0.2)',
                    borderColor: 'rgba(37, 99, 235, 1)',
                    borderWidth: 2,
                    pointBackgroundColor: '#fff',
                    pointBorderColor: '#dc2626'
                }]
            },
            options: {
                scales: {
                    r: {
                        angleLines: { display: true },
                        suggestedMin: 0,
                        suggestedMax: 100,
                        ticks: { display: false } // Hide numbers for cleaner look
                    }
                },
                plugins: {
                    legend: { display: false }
                }
            }
        });
    }

    // --- Type Definitions Data ---
    function getTypeData(key) {
        const db = {
            "LHDM": {
                title: "The Entertainer (王道エンターテイナー)",
                overview: "あなたは**「明快さ」「優しさ」「勢い」**を兼ね備えた、テレビのゴールデンタイムそのもののような存在です。誰も傷つけず、誰にでも伝わるネタを、圧倒的な熱量で提供できます。論理的な構成力とサービス精神の塊です。",
                role: "場の中心で進行役（MC）を務めつつ、自らも笑いを取るリーダー。飲み会やイベントでは欠かせない存在。",
                tags: ["MC気質", "サービス精神", "リアクション芸", "空気読みの達人"],
                ref: "明石家さんま、ザキヤマ、一般的な「クラスの人気者」"
            },
            "LHDC": {
                title: "The Niche Evangelist (熱血オタク解説者)",
                overview: "特定のジャンルへの深い愛と知識（Core）を、論理的かつハイテンション（Dynamic）に語り尽くすタイプ。興味のない人さえもその熱量で笑わせてしまう、プレゼンの天才です。",
                role: "特定の話題になった瞬間に覚醒し、場を独壇場にする「愛すべきマニア」。",
                tags: ["早口", "知識量", "推し語り", "解説役"],
                ref: "さかなクン、岡田斗司夫、アメトーークの〇〇芸人"
            },
            "LHSM": {
                title: "The Soothing Observer (癒やしの観察者)",
                overview: "日常の些細な「あるある」を、穏やかなトーン（Static）で丁寧に切り取るスタイル。爆笑よりも「共感」と「安心」を生み出す、ラジオパーソナリティのような温かいユーモアを持ちます。",
                role: "激しいボケ合戦には参加せず、一歩引いてニコニコしながら的確なコメントを添えるバランサー。",
                tags: ["エッセイスト", "共感力", "平和主義", "天然のふりをした知性"],
                ref: "博多華丸・大吉、タモリ（昼の顔）、日常系エッセイ漫画家"
            },
            "LHSC": {
                title: "The Witty Scholar (書斎の賢者)",
                overview: "豊富な知識と教養を背景に、静かにウィットに富んだジョークを飛ばすタイプ。大声で笑わせるのではなく、知的な「気づき」を与えることで、聴衆をニヤリとさせます。",
                role: "騒がしい集団の中で、ボソッとインテリジェンスな一言を放ち、一瞬で爆笑をさらうスナイパー。",
                tags: ["言葉遊び", "教養", "含蓄", "英国式ユーモア"],
                ref: "市川萬葉、小林賢太郎（の知的な側面）、大学教授の冗談"
            },
            
            "LPDM": {
                title: "The Roasting Machine (マシンガン毒舌)",
                overview: "「正論」を武器に、世の中の矛盾や他者の欠点を大声で斬りまくるタイプ。その攻撃性は、大衆（Mass）が言いたくても言えないことを代弁するカタルシスとして機能します。",
                role: "会議や議論で、場の欺瞞を打ち砕く「切り込み隊長」。敵も作るが味方も多い。",
                tags: ["歯に衣着せぬ", "論破", "ツッコミ", "代弁者"],
                ref: "上田晋也、有吉弘行（全盛期）、坂上忍"
            },
